PORT=3000
NODE_ENV=production
PUBLIC_URL=https://tickets.tudominio.com
FIREBASE_SERVICE_ACCOUNT_FILE=/ruta/segura/firebase-service-account.json

# En produccion STAFF_USERS es obligatorio. Usa passwordHash con scrypt; nunca subas contrasenas.
STAFF_USERS='[{"username":"admin@tudominio.com","passwordHash":"scrypt$CAMBIA_ESTE_HASH","role":"admin","name":"Administrador"}]'

# Firebase Firestore para persistencia real.
FIREBASE_PROJECT_ID=tu-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA\n-----END PRIVATE KEY-----\n"

# SMTP para enviar confirmaciones y tickets.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=tu-contrasena-de-aplicacion
SMTP_FROM="WhineUp <tu-correo@gmail.com>"

# Número para pagos manuales.
PAYMENT_PHONE=+50600000000
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_WEBHOOK_ID=...
