PORT=3000
NODE_ENV=production

# Base de los enlaces y de la imagen del QR que viajan dentro de los correos.
# Sin esto, los correos enlazan al deployment concreto de Vercel en vez de al
# dominio bueno (y en local, a localhost).
PUBLIC_URL=https://whineup-evento.vercel.app

# Supabase (Postgres + Auth) para persistencia real.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
SUPABASE_ANON_KEY=tu-anon-key

# EmailJS. Hacen falta las cinco: si falta una, no sale ningun correo y el
# arranque lo avisa en el log. La clave privada nunca llega al navegador,
# porque los correos se envian desde el servidor con la API REST.
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_PUBLIC_KEY=tu-public-key
EMAILJS_PRIVATE_KEY=tu-private-key
EMAILJS_TEMPLATE_COMPRA=template_xxxxxxx
EMAILJS_TEMPLATE_TICKET=template_xxxxxxx

# Numero de SINPE Movil al que paga el comprador. Se muestra en la pagina de
# compra: si falta, el sitio dice que el pago no esta disponible.
PAYMENT_PHONE=+50600000000
