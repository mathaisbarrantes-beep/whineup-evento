# =====================================================================
# WhineUp - variables de entorno
#
# Copia este archivo a .env para desarrollo local.
# NUNCA subas .env al repositorio: ya esta en .gitignore.
# En produccion define estas variables en el panel de tu proveedor
# (Render / Vercel / Railway), no en un archivo.
# =====================================================================

NODE_ENV=production
PORT=3000

# URL publica exacta, sin barra final. Se usa para construir los enlaces
# del QR que van dentro del correo. Obligatoria en produccion.
PUBLIC_URL=https://tickets.tudominio.com

# Detras de un proxy (Render, Vercel, Nginx) debe estar activo para que
# el limitador de peticiones vea la IP real del visitante.
TRUST_PROXY=true

# ---------------------------------------------------------------------
# 1. Firma de los codigos QR   (npm run secreto)
# ---------------------------------------------------------------------
# Sin este secreto cualquiera podria fabricar un QR valido.
# Si lo cambias, TODOS los QR emitidos dejan de funcionar.
TICKET_SIGNING_SECRET=genera-uno-con-npm-run-secreto

# ---------------------------------------------------------------------
# 2. Personal autorizado   (npm run staff -- correo "CLAVE" admin "Nombre")
# ---------------------------------------------------------------------
# Solo passwordHash. Las contrasenas en texto plano estan bloqueadas
# en produccion.
STAFF_USERS='[{"username":"admin@tudominio.com","passwordHash":"scrypt$SALT$HASH","role":"admin","name":"Administrador"}]'

SESSION_TTL_HOURS=12

# ---------------------------------------------------------------------
# 3. Firestore  (obligatorio en produccion)
# ---------------------------------------------------------------------
# Es lo que garantiza que un QR se use UNA sola vez. Sin el, el servidor
# se niega a arrancar en produccion.
FIREBASE_PROJECT_ID=tu-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA\n-----END PRIVATE KEY-----\n"
# Alternativa: ruta a un archivo de cuenta de servicio fuera del repositorio.
# FIREBASE_SERVICE_ACCOUNT_FILE=/ruta/segura/firebase-service-account.json

# ---------------------------------------------------------------------
# 4. EmailJS  (canal principal de correo)
# ---------------------------------------------------------------------
# Se usa desde el SERVIDOR con la API REST. La clave privada nunca llega
# al navegador. En EmailJS: Account > Security > activa
# "Allow EmailJS API for non-browser applications".
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_PUBLIC_KEY=tu_public_key
EMAILJS_PRIVATE_KEY=tu_private_key
EMAILJS_TEMPLATE_COMPRA=template_xxxxxxx
EMAILJS_TEMPLATE_TICKET=template_yyyyyyy

# ---------------------------------------------------------------------
# 5. SMTP  (respaldo opcional si EmailJS falla)
# ---------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASSWORD=tu-contrasena-de-aplicacion
# SMTP_FROM="WhineUp <tu-correo@gmail.com>"

# ---------------------------------------------------------------------
# 6. Catalogo y pagos
# ---------------------------------------------------------------------
# Opcional: sobrescribe el catalogo de eventos sin tocar codigo.
# EVENTOS='[{"id":"halloween-party","nombre":"HALLOWEEN PARTY","fecha":"31 Oct 2026","lugar":"WhineUp CR","precio":45000,"moneda":"CRC","categoria":"General","descripcion":"..."}]'

PAYMENT_PHONE=+50600000000
