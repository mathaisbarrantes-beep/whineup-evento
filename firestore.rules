rules_version = '2';

// Ningun cliente accede a Firestore directamente: todo pasa por el servidor,
// que usa el SDK de administracion y se salta estas reglas.
//
// Cerrar la puerta importa: sin esto, cualquiera con el projectId podria leer
// la lista completa de compradores, o marcar sus propias entradas como validas.
//
// Publicar:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
